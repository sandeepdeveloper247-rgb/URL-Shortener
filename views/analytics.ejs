<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Analytics</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:'Segoe UI',sans-serif;
    background:linear-gradient(135deg,#4f46e5,#7c3aed,#2563eb);
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    padding:40px;
}

.container{
    width:1000px;
    max-width:95%;
    background:rgba(255,255,255,.18);
    backdrop-filter:blur(18px);
    border-radius:20px;
    padding:40px;
    box-shadow:0 20px 40px rgba(0,0,0,.25);
}

h1{
    color:white;
    text-align:center;
    margin-bottom:30px;
}
.chart-container{
    background:white;
    padding:25px;
    border-radius:18px;
    margin-top:25px;
}
.back-btn{
    display:inline-block;
    padding:12px 20px;
    background:#2563eb;
    color:white;
    text-decoration:none;
    border-radius:10px;
    margin-bottom:30px;
}

.back-btn:hover{
    background:#1d4ed8;
}

.cards{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:20px;
    margin-bottom:40px;
}

.card{
    background:white;
    padding:20px;
    border-radius:15px;
    text-align:center;
}

.card h3{
    color:#555;
    margin-bottom:10px;
}

.card p{
    font-size:18px;
    font-weight:bold;
    color:#2563eb;
    word-break:break-word;
}

table{
    width:100%;
    border-collapse:collapse;
    background:white;
    border-radius:15px;
    overflow:hidden;
}

thead{
    background:#1e40af;
    color:white;
}

th,td{
    padding:15px;
    text-align:center;
}

tbody tr:nth-child(even){
    background:#f8fafc;
}

tbody tr:hover{
    background:#dbeafe;
}

.no-clicks{
    color:white;
    text-align:center;
    font-size:18px;
    margin-top:20px;
}
</style>

</head>

<body>

<div class="container">

<a href="/" class="back-btn">
← Back to Dashboard
</a>

<h1>📊 URL Analytics</h1>

<div class="cards">

<div class="card">
<h3>Short URL</h3>
<p>
<%= url.shortId %>
</p>
</div>

<div class="card">
<h3>Original URL</h3>
<p>
<%= url.redirectURL %>
</p>
</div>

<div class="card">
<h3>Total Clicks</h3>
<p>
<%= url.visitHistory.length %>
</p>
</div>

<div class="card">
<h3>Created On</h3>
<p>
<%= url.createdAt.toLocaleString() %>
</p>
</div>

<div class="card">
<h3>Last Click</h3>

<p>

<% if(url.visitHistory.length>0){ %>

<%= url.visitHistory[url.visitHistory.length-1].timestamp.toLocaleString() %>

<% } else { %>

No Clicks Yet

<% } %>

</p>

</div>

</div>

<% if(url.visitHistory.length>0){ %>

<table>

<thead>

<tr>

<th>S.No.</th>

<th>Visited At</th>

</tr>

</thead>

<tbody>

<% url.visitHistory.forEach((visit,index)=>{ %>

<tr>

<td><%= index+1 %></td>

<td><%= visit.timestamp.toLocaleString() %></td>

</tr>

<% }) %>

</tbody>

</table>

<% } else { %>

<div class="no-clicks">

No one has visited this short URL yet.

</div>

<% } %>
<h2 style="color:white; margin-top:40px; margin-bottom:20px;">
    📈 Clicks Over Time
</h2>

<div class="chart-container">
<canvas id="clickChart"></canvas>
</div>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

const clickData = <%- JSON.stringify(clickData) %>;

const labels = Object.keys(clickData);
const values = Object.values(clickData);

new Chart(document.getElementById("clickChart"), {

       type: "line",

    data: {
        labels: labels,
        datasets: [{
            label: "Clicks",
            data: values,
            borderColor: "#22c55e",
            backgroundColor: "rgba(34,197,94,0.25)",
            borderWidth: 4,
            pointRadius: 6,
            pointHoverRadius: 8,
            pointBackgroundColor: "#22c55e",
            fill: true,
            tension: 0.35
        }]
    },

    options: {
        responsive: true,

        plugins: {
            legend: {
                labels: {
                    color: "white",
                    font: {
                        size: 15
                    }
                }
            }
        },

        scales: {
            x: {
                ticks: {
                    color: "white"
                },
                grid: {
                    color: "rgba(255,255,255,0.15)"
                }
            },

            y: {
                beginAtZero: true,
                ticks: {
                    color: "white",
                    precision: 0
                },
                grid: {
                    color: "rgba(255,255,255,0.15)"
                }
            }
        }
    }

});

</script>
</body>
</html>