<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Edit URL</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Segoe UI, sans-serif;
    background:linear-gradient(135deg,#4f46e5,#7c3aed,#2563eb);
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
}

.container{
    width:500px;
    background:white;
    padding:35px;
    border-radius:18px;
    box-shadow:0 15px 35px rgba(0,0,0,.25);
}

h1{
    text-align:center;
    margin-bottom:25px;
    color:#1e40af;
}

label{
    display:block;
    margin-bottom:8px;
    font-weight:bold;
}

input{
    width:100%;
    padding:14px;
    margin-bottom:20px;
    border:1px solid #ddd;
    border-radius:10px;
    font-size:15px;
}

button{
    width:100%;
    padding:14px;
    border:none;
    border-radius:10px;
    background:#2563eb;
    color:white;
    font-size:16px;
    cursor:pointer;
}

button:hover{
    background:#1d4ed8;
}

.back{
    display:block;
    text-align:center;
    margin-top:18px;
    text-decoration:none;
    color:#2563eb;
}
</style>

</head>
<body>

<div class="container">

<h1>Edit URL</h1>

<form action="/url/edit/<%= url._id %>" method="POST">

<label>Short URL</label>

<input
type="text"
value="<%= url.shortId %>"
readonly
>

<label>Original URL</label>

<input
type="url"
name="url"
value="<%= url.redirectURL %>"
required
>

<button type="submit">
Update URL
</button>

</form>

<a href="/" class="back">
← Back to Dashboard
</a>

</div>

</body>
</html>