<!DOCTYPE html>
<html lang="en">
<head>
<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;
    background:linear-gradient(135deg,#4f46e5,#7c3aed,#2563eb);
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    padding:40px 20px;
}

.container{
    width:1100px;
    max-width:95%;
    background:rgba(255,255,255,0.18);
    backdrop-filter:blur(18px);
    -webkit-backdrop-filter:blur(18px);
    border:1px solid rgba(255,255,255,.25);
    border-radius:22px;
    padding:40px;
    box-shadow:0 20px 45px rgba(0,0,0,.25);
}

h1{
    color:white;
    text-align:center;
    font-size:42px;
    margin-bottom:10px;
    letter-spacing:1px;
}

.subtitle{
    color:#e5e7eb;
    text-align:center;
    margin-bottom:35px;
    font-size:17px;
}

form:not(.logout-form){
    display:flex;
    gap:15px;
    margin-bottom:25px;
}

input{
    flex:1;
    padding:16px 18px;
    border:none;
    border-radius:12px;
    font-size:16px;
    outline:none;
    transition:.3s;
}

input:focus{
    box-shadow:0 0 0 4px rgba(255,255,255,.25);
}

button{
    background:#2563eb;
    color:white;
    border:none;
    padding:16px 28px;
    border-radius:12px;
    font-size:16px;
    font-weight:600;
    cursor:pointer;
    transition:.3s;
}

button:hover{
    background:#1d4ed8;
    transform:translateY(-2px);
    box-shadow:0 8px 18px rgba(37,99,235,.4);
}

.result{
    background:#dcfce7;
    border-left:6px solid #16a34a;
    border-radius:12px;
    padding:18px;
    margin-bottom:30px;
}

.result h3{
    color:#166534;
    margin-bottom:10px;
}

.result a{
    color:#1d4ed8;
    font-weight:bold;
    text-decoration:none;
    word-break:break-all;
}

.result a:hover{
    text-decoration:underline;
}

hr{
    border:none;
    border-top:1px solid rgba(255,255,255,.25);
    margin:35px 0;
}

h2{
    color:white;
    margin-bottom:20px;
    text-align:left;
}

table{
    width:100%;
    border-collapse:collapse;
    overflow:hidden;
    border-radius:15px;
    background:white;
}

thead{
    background:#1e40af;
    color:white;
}

th{
    padding:16px;
    font-size:15px;
}

td{
    padding:16px;
    text-align:center;
    border-bottom:1px solid #eee;
    max-width:250px;
}
th:last-child,
td:last-child{
    min-width:220px;
}
tbody tr{
    transition:.25s;
}

tbody tr:nth-child(even){
    background:#f8fafc;
}

tbody tr:hover{
    background:#dbeafe;
    transform:scale(1.005);
}

td a{
    color:#2563eb;
    font-weight:600;
    text-decoration:none;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
    display:block;
}

td a:hover{
    text-decoration:underline;
}

.badge{
    display:inline-block;
    padding:6px 12px;
    border-radius:50px;
    background:#dbeafe;
    color:#1d4ed8;
    font-weight:600;
}
.top-bar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:25px;
}

.logout-form{
    margin:0;
}

.logout-btn{
    background:linear-gradient(135deg,#ef4444,#dc2626);
    color:white;
    border:none;
    padding:12px 22px;
    border-radius:12px;
    font-size:15px;
    font-weight:600;
    cursor:pointer;
    transition:all .3s ease;
    box-shadow:0 8px 20px rgba(239,68,68,.35);
}

.logout-btn:hover{
    background:linear-gradient(135deg,#dc2626,#b91c1c);
    transform:translateY(-2px);
}
.edit-btn{
    background:#f59e0b;
}

.edit-btn:hover{
    background:#d97706;
}
.actions{
    display:flex;
    gap:6px;
    flex-wrap:wrap;
    justify-content:center;

}

.action-btn{
    padding:6px 10px;
    border:none;
    border-radius:8px;
    cursor:pointer;
    font-size:13px;
    color:white;
    transition:.25s;
}

.copy-btn{
    background:#2563eb;
}

.copy-btn:hover{
    background:#1d4ed8;
}

.analytics-btn{
    background:#16a34a;
}

.analytics-btn:hover{
    background:#15803d;
}

.delete-btn{
    background:#dc2626;
}

.delete-btn:hover{
    background:#b91c1c;
}
.action-link{
    display:inline-flex;
    justify-content:center;
    align-items:center;
    text-decoration:none;
}
.stats{
    display:flex;
    gap:20px;
    margin-bottom:30px;
}

.card{
    flex:1;
    background:rgba(255,255,255,.18);
    backdrop-filter:blur(12px);
    border-radius:16px;
    padding:22px;
    text-align:center;
    color:white;
    box-shadow:0 8px 18px rgba(0,0,0,.15);
}

.card h2{
    font-size:34px;
    margin-bottom:10px;
}

.card p{
    color:#e5e7eb;
    font-size:15px;
}
.stats{
    flex-direction:column;
}
@media(max-width:768px){
.stats{
    flex-direction:column;
}
    .container{
        padding:25px;
    }

    form{
        flex-direction:column;
    }

    button{
        width:100%;
    }

    table{
        font-size:14px;
    }

    th,
    td{
        padding:10px;
    }

    h1{
        font-size:32px;
    }
    
}
</style>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home Page</title>
</head>
<body>
  <div class="container">
    
        <div class="top-bar">
        <h1>🔗 URL Shortener</h1>

        <form action="/user/logout" method="POST" class="logout-form">
            <button type="submit" class="logout-btn">
                🚪 Logout
            </button>
        </form>
    </div>
    <% if (id) { %>
  <div class="result">
    <h3>Your Short URL</h3>
    <a href="/url/<%= id %>" target="_blank">
      http://localhost:8002/url/<%= id %>
    </a>
  </div>
<% } %>
<div class="stats">

<div class="card">
    <h2><%= urls.length %></h2>
    <p>Total URLs</p>
</div>

<div class="card">
    <h2>
        <%= urls.reduce((sum,url)=>sum+url.visitHistory.length,0) %>
    </h2>
    <p>Total Clicks</p>
</div>

<div class="card">
    <h2>
        <%= urls.length>0 ? Math.max(...urls.map(u=>u.visitHistory.length)) : 0 %>
    </h2>
    <p>Highest Clicks</p>
</div>

</div>
    <p class="subtitle">
    Paste your long URL below and generate a secure short link instantly.
</p>

    <form action="/url" method="POST">
      <input
        type="url"
        name="url"
        placeholder="https://example.com"
        required
      />
        <input
    type="text"
    name="customAlias"
    placeholder="Custom alias (optional)"
>
      <button type="submit">Shorten URL</button>
    </form>
    <hr style="margin:30px 0;">


<input
    type="text"
    id="searchInput"
    placeholder="🔍 Search by Short URL or Original URL..."
    style="
        width:100%;
        margin-bottom:20px;
        padding:14px;
        border-radius:10px;
        border:none;
        font-size:16px;
    "
>
<h2>All Shortened URLs</h2>

<table>
  <thead>
    <tr>
    <th>S.No.</th>
    <th>Short URL</th>
    <th>Original URL</th>
    <th>Created On</th>
    <th>Clicks</th>
    <th>Actions</th>
</tr>
  </thead>

  <tbody id="urlTable">

<% if(urls.length === 0){ %>

<tr>
    <td colspan="6" style="padding:40px;">
        <div style="text-align:center;">
            <h3 style="color:#666;">📭 No URLs yet</h3>
            <p style="margin-top:10px;color:#888;">
                Shorten your first URL using the form above.
            </p>
        </div>
    </td>
</tr>

<% } else { %>

<% urls.forEach((url, index) => { %>
<tr>
    <td><%= index + 1 %></td>

    <td>
        <a href="/url/<%= url.shortId %>" target="_blank">
            <%= url.shortId %>
        </a>
    </td>

    <td>
        <a href="<%= url.redirectURL %>" target="_blank">
            <%= url.redirectURL %>
        </a>
    </td>

    <td>
        <%= url.createdAt.toLocaleString() %>
    </td>

    <td>
        <span class="badge">
            <%= url.visitHistory.length %> Visits
        </span>
    </td>

    <td>
        <div class="actions">

            <button
                class="action-btn copy-btn"
                onclick="copyURL('<%= url.shortId %>')">
                📋 Copy
            </button>

            <a
                href="/url/analytics/<%= url.shortId %>"
                class="action-btn analytics-btn action-link">
                📊 Analytics
            </a>
            <a
    href="/url/edit/<%= url._id %>"
    class="action-btn edit-btn action-link"
>
    ✏ Edit
</a>
            <form
                action="/url/delete/<%= url._id %>"
                method="POST"
                style="display:inline">

                <button class="action-btn delete-btn">
                    🗑 Delete
                </button>

            </form>

        </div>
    </td>

</tr>
<% }) %>

<% } %>

</tbody>
</table>
  </div>

<script>
function copyURL(shortId){

    const shortURL = `${window.location.origin}/url/${shortId}`;

    navigator.clipboard.writeText(shortURL);

    const buttons = document.querySelectorAll(".copy-btn");

    buttons.forEach(button=>{

        if(button.getAttribute("onclick").includes(shortId)){

            button.innerHTML="✅ Copied";

            setTimeout(()=>{
                button.innerHTML="📋 Copy";
            },1500);

        }

    });

}
const searchInput = document.getElementById("searchInput");

searchInput.addEventListener("keyup", function () {

    const value = this.value.toLowerCase();

    const rows = document.querySelectorAll("#urlTable tr");

    rows.forEach(row => {

        if(row.innerText.toLowerCase().includes(value)){
            row.style.display = "";
        }
        else{
            row.style.display = "none";
        }

    });

});
</script>
</body>
</html> 